datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Expense {
  id         String   @id @default(uuid())
  title      String
  amount     Float
  category   String
  date       DateTime
  currency   String   @default("ARS")
  note       String? 
  receiptUrl String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
