datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id         String   @id @default(uuid())
  title      String
  amount     Decimal  @db.Decimal(12, 2)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  date       DateTime @db.Date
  currency   String   @default("ARS")
  note       String?
  receiptUrl String?

  // Purchases in installments ("cuotas") become one Expense per month sharing a group id.
  // The title is stored without the "2/6" suffix; the UI adds it from these fields.
  installmentGroupId String?
  installmentNumber  Int?
  installmentCount   Int?

  // Who loaded it (from the Google session); null for expenses loaded before login existed
  createdBy     String?
  createdByName String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([installmentGroupId])
}

// "Pre-gasto": captured quickly (usually a photo), completed later into an Expense.
// Kept apart from Expense so half-filled data never leaks into totals or charts.
model PendingExpense {
  id        String   @id @default(uuid())
  photoKey  String?  // storage key, served through /api/photos/<key>
  amount    Decimal? @db.Decimal(12, 2)
  note      String?
  createdBy String?  // email of the user who captured it
  createdAt DateTime @default(now())

  // What the AI read from the photo, filled in the background after capture.
  // aiStatus: "reading" | "done" | "failed" (null: no photo or AI not configured)
  aiStatus              String?
  suggestedAmount       Decimal? @db.Decimal(12, 2)
  suggestedCurrency     String?
  suggestedTitle        String?
  suggestedCategoryId   String?
  suggestedDate         DateTime? @db.Date
  suggestedInstallments Int?
}

// Personal keys for the iPhone Atajos (Siri / widget) shortcut, which can't do the Google
// login. Only a SHA-256 hash is stored; the key itself is shown once when created.
model ApiToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  email      String    // owner; must still be in ALLOWED_EMAILS for the key to work
  name       String?
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}
