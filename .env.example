# Copy to .env and fill in. Never commit real values.
DATABASE_URL="postgresql://expense:expense@localhost:5434/expense_report"

# Auth (next-auth v4, Google only)
NEXTAUTH_SECRET=""            # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3100"   # in Vercel Production: https://expense-report-mu.vercel.app
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAILS=""             # comma-separated Google accounts allowed to sign in

# Receipt photos: connecting a *private* Vercel Blob store to the project sets BLOB_STORE_ID
# in Vercel (auth is via the deployment's OIDC token, no secret needed). Leave both empty
# locally to store photos in ./.uploads instead of the real store.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
