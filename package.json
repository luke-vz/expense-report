{
  "name": "expense-report",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack && npm run migrate:production",
    "migrate:production": "if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy; else echo 'Skipping migrations (not a Vercel production build)'; fi",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "framer-motion": "^12.23.21",
    "next": "^15.5.27",
    "prisma": "^6.16.2",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
